# Keycard zone URL for metadata discovery (required)
KEYCARD_ZONE_URL="https://your-zone.keycard.cloud"

# Confidential client credentials for the background agent (required)
KEYCARD_CLIENT_ID="background-agent"
KEYCARD_CLIENT_SECRET=""

# Target user to impersonate; becomes "sub" in the issued token (required)
KEYCARD_USER="alice@example.com"

# Target resource URI for the issued token (optional)
KEYCARD_RESOURCE="https://api.github.com"

# Space-separated scopes requested for the issued token (optional)
KEYCARD_SCOPES=""
