{
  "name": "@keycardai/eve",
  "version": "0.1.0",
  "description": "[Preview] Keycard auth adapters for eve agents: a zone token verifier for the channel auth walk, Keycard-backed connection auth, and interactive authorization over the zone's web flow",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/keycardai/typescript-sdk.git",
    "directory": "packages/eve"
  },
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "types": "./dist/esm/index.d.ts"
    },
    "./testing": {
      "import": "./dist/esm/testing/index.js",
      "types": "./dist/esm/testing/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "typesVersions": {
    "*": {
      "*": [
        "./dist/esm/*"
      ]
    }
  },
  "scripts": {
    "build": "pnpm run build:esm",
    "build:esm": "tsc -p tsconfig.prod.json && echo '{\"type\": \"module\"}' > dist/esm/package.json",
    "test": "NODE_OPTIONS='--experimental-vm-modules' jest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@keycardai/oauth": "workspace:*"
  },
  "peerDependencies": {
    "eve": ">=0.47.3 <0.48.0"
  },
  "devDependencies": {
    "@jest/globals": "^30.0.4",
    "@types/node": "^25.6.0",
    "eve": "0.47.3",
    "jest": "^30.0.4",
    "ts-jest": "^29.4.7",
    "typescript": "^5.8.3"
  }
}
