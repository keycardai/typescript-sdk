{
  "name": "@keycardai/langchain",
  "version": "0.3.0",
  "description": "[Preview] Keycard grant middleware for LangChain agents: delegated access at the tool-call boundary, per-run identity, and LangGraph interrupts for sign-in and consent",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/keycardai/typescript-sdk.git",
    "directory": "packages/langchain"
  },
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "types": "./dist/esm/index.d.ts"
    },
    "./serve": {
      "import": "./dist/esm/serve/index.js",
      "require": "./dist/cjs/serve/index.js",
      "types": "./dist/esm/serve/index.d.ts"
    },
    "./testing": {
      "import": "./dist/esm/testing/index.js",
      "require": "./dist/cjs/testing/index.js",
      "types": "./dist/esm/testing/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "typesVersions": {
    "*": {
      "*": [
        "./dist/esm/*"
      ]
    }
  },
  "scripts": {
    "build": "pnpm run build:esm && pnpm run build:cjs",
    "build:esm": "tsc -p tsconfig.prod.json && echo '{\"type\": \"module\"}' > dist/esm/package.json",
    "build:cjs": "tsc -p tsconfig.cjs.json && echo '{\"type\": \"commonjs\"}' > dist/cjs/package.json",
    "test": "NODE_OPTIONS='--experimental-vm-modules' jest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@keycardai/oauth": "workspace:*",
    "zod": "^3.25.74"
  },
  "peerDependencies": {
    "@langchain/core": ">=1.0.0",
    "@langchain/langgraph": ">=1.0.0",
    "@langchain/langgraph-sdk": ">=1.0.0",
    "langchain": ">=1.0.0"
  },
  "peerDependenciesMeta": {
    "@langchain/langgraph-sdk": {
      "optional": true
    }
  },
  "devDependencies": {
    "@jest/globals": "^30.0.4",
    "@langchain/core": "^1.2.9",
    "@langchain/langgraph": "^1.4.13",
    "@langchain/langgraph-api": "^1.4.5",
    "@langchain/langgraph-sdk": "^1.10.0",
    "@types/node": "^25.6.0",
    "jest": "^30.0.4",
    "langchain": "^1.5.10",
    "ts-jest": "^29.4.7",
    "typescript": "^5.8.3"
  }
}
