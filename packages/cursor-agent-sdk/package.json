{
  "name": "@keycardai/cursor-agent-sdk",
  "version": "0.2.0",
  "description": "[Preview] Keycard auth adapters for Cursor Agent SDK agents: a zone token verifier for bearerAuth, and Keycard-backed connection auth that acts as the agent, on behalf of the caller, or for a mapped user",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/keycardai/typescript-sdk.git",
    "directory": "packages/cursor-agent-sdk"
  },
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "types": "./dist/esm/index.d.ts"
    },
    "./testing": {
      "import": "./dist/esm/testing/index.js",
      "types": "./dist/esm/testing/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "typesVersions": {
    "*": {
      "*": [
        "./dist/esm/*"
      ]
    }
  },
  "scripts": {
    "build": "pnpm run build:esm",
    "build:esm": "tsc -p tsconfig.prod.json && echo '{\"type\": \"module\"}' > dist/esm/package.json",
    "test": "NODE_OPTIONS='--experimental-vm-modules' jest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@keycardai/oauth": "workspace:^"
  },
  "peerDependencies": {
    "@grok/agent-sdk": ">=0.3.0 <0.4.0"
  },
  "devDependencies": {
    "@grok/agent-sdk": "0.3.0",
    "@jest/globals": "^30.5.2",
    "@types/node": "^25.6.0",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.7",
    "typescript": "^5.8.3"
  }
}
